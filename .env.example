# Copy to .env and fill in LOCAL, NON-PRODUCTION values. Never commit .env.

# PostgreSQL (docker compose)
POSTGRES_DB=autorent
POSTGRES_USER=autorent
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Backend
ConnectionStrings__AutoRent=Host=localhost;Port=5432;Database=autorent;Username=autorent;Password=change-me
Jwt__Issuer=autorent-api
Jwt__Audience=autorent-web
Jwt__SigningKey=replace-with-a-random-string-of-at-least-32-characters
Jwt__AccessTokenMinutes=30
Cors__AllowedOrigins=http://localhost:5173

# Passwords for the development seed accounts (admin@autorent.local and the two customers).
# Used only when the Users table is empty.
Seed__AdminPassword=change-me-admin
Seed__UserPassword=change-me-user

# Frontend
# Optional. Defaults to /api/v1, which the Vite dev server proxies to the API on :5000.
# VITE_API_BASE_URL=http://localhost:5000/api/v1

# Stripe Test Mode (later phase) — test keys only
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
