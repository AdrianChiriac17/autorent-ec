@model AutoRentCraiova.Models.Car

<div class="modal-car-details" style="padding: 20px;">
    <h2 class="modal-title" style="margin-bottom: 20px; text-align: center;">Editeaza @Model.Brand @Model.Model</h2>
    
    <form id="editCarForm" asp-action="Edit" method="post" enctype="multipart/form-data" class="login-form" style="background: transparent; padding: 0; box-shadow: none; max-width: 100%;">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImageUrl" />
        <input type="hidden" asp-for="Status" />
        
        <div class="row">
            <div class="col-md-6 mb-3">
                <div style="text-align: left; margin-bottom: 15px;">
                    <label asp-for="Brand" style="color: #bdc3c7; margin-bottom: 8px; display: block; font-family: 'Montserrat', sans-serif;">Brand</label>
                    <input asp-for="Brand" required style="width: 100%; padding: 12px; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; outline: none; font-size: 1rem; font-family: 'Montserrat', sans-serif; background: rgba(255, 255, 255, 0.05); color: #ffffff;" />
                    <span asp-validation-for="Brand" class="text-danger" style="display: block; margin-top: 5px; font-size: 0.85rem;"></span>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div style="text-align: left; margin-bottom: 15px;">
                    <label asp-for="Model" style="color: #bdc3c7; margin-bottom: 8px; display: block; font-family: 'Montserrat', sans-serif;">Model</label>
                    <input asp-for="Model" required style="width: 100%; padding: 12px; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; outline: none; font-size: 1rem; font-family: 'Montserrat', sans-serif; background: rgba(255, 255, 255, 0.05); color: #ffffff;" />
                    <span asp-validation-for="Model" class="text-danger" style="display: block; margin-top: 5px; font-size: 0.85rem;"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <div style="text-align: left; margin-bottom: 15px;">
                    <label asp-for="VIN" style="color: #bdc3c7; margin-bottom: 8px; display: block; font-family: 'Montserrat', sans-serif;">Serie Sasiu (VIN)</label>
                    <input asp-for="VIN" required style="width: 100%; padding: 12px; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; outline: none; font-size: 1rem; font-family: 'Montserrat', sans-serif; background: rgba(255, 255, 255, 0.05); color: #ffffff;" />
                    <span asp-validation-for="VIN" class="text-danger" style="display: block; margin-top: 5px; font-size: 0.85rem;"></span>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div style="text-align: left; margin-bottom: 15px;">
                    <label asp-for="LicensePlate" style="color: #bdc3c7; margin-bottom: 8px; display: block; font-family: 'Montserrat', sans-serif;">Numar Inmatriculare</label>
                    <input asp-for="LicensePlate" required style="width: 100%; padding: 12px; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; outline: none; font-size: 1rem; font-family: 'Montserrat', sans-serif; background: rgba(255, 255, 255, 0.05); color: #ffffff;" />
                    <span asp-validation-for="LicensePlate" class="text-danger" style="display: block; margin-top: 5px; font-size: 0.85rem;"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <div style="text-align: left; margin-bottom: 15px;">
                    <label asp-for="Year" style="color: #bdc3c7; margin-bottom: 8px; display: block; font-family: 'Montserrat', sans-serif;">An</label>
                    <input asp-for="Year" type="number" required style="width: 100%; padding: 12px; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; outline: none; font-size: 1rem; font-family: 'Montserrat', sans-serif; background: rgba(255, 255, 255, 0.05); color: #ffffff;" />
                    <span asp-validation-for="Year" class="text-danger" style="display: block; margin-top: 5px; font-size: 0.85rem;"></span>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div style="text-align: left; margin-bottom: 15px;">
                    <label asp-for="PricePerDay" style="color: #bdc3c7; margin-bottom: 8px; display: block; font-family: 'Montserrat', sans-serif;">Pret / Zi (RON)</label>
                    <input asp-for="PricePerDay" type="number" step="0.01" required style="width: 100%; padding: 12px; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; outline: none; font-size: 1rem; font-family: 'Montserrat', sans-serif; background: rgba(255, 255, 255, 0.05); color: #ffffff;" />
                    <span asp-validation-for="PricePerDay" class="text-danger" style="display: block; margin-top: 5px; font-size: 0.85rem;"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <div style="text-align: left; margin-bottom: 15px;">
                    <label asp-for="Seats" style="color: #bdc3c7; margin-bottom: 8px; display: block; font-family: 'Montserrat', sans-serif;">Numar Locuri</label>
                    <input asp-for="Seats" type="number" min="2" max="9" required style="width: 100%; padding: 12px; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; outline: none; font-size: 1rem; font-family: 'Montserrat', sans-serif; background: rgba(255, 255, 255, 0.05); color: #ffffff;" />
                    <span asp-validation-for="Seats" class="text-danger" style="display: block; margin-top: 5px; font-size: 0.85rem;"></span>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div style="text-align: left; margin-bottom: 15px;">
                    <label asp-for="Doors" style="color: #bdc3c7; margin-bottom: 8px; display: block; font-family: 'Montserrat', sans-serif;">Numar Usi</label>
                    <input asp-for="Doors" type="number" min="2" max="5" required style="width: 100%; padding: 12px; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; outline: none; font-size: 1rem; font-family: 'Montserrat', sans-serif; background: rgba(255, 255, 255, 0.05); color: #ffffff;" />
                    <span asp-validation-for="Doors" class="text-danger" style="display: block; margin-top: 5px; font-size: 0.85rem;"></span>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div style="text-align: left; margin-bottom: 15px;">
                    <label asp-for="AverageConsumption" style="color: #bdc3c7; margin-bottom: 8px; display: block; font-family: 'Montserrat', sans-serif;">Consum Mediu</label>
                    <input asp-for="AverageConsumption" type="number" step="0.1" required style="width: 100%; padding: 12px; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; outline: none; font-size: 1rem; font-family: 'Montserrat', sans-serif; background: rgba(255, 255, 255, 0.05); color: #ffffff;" />
                    <span asp-validation-for="AverageConsumption" class="text-danger" style="display: block; margin-top: 5px; font-size: 0.85rem;"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <div style="text-align: left; margin-bottom: 15px; padding-top: 35px; display: flex; align-items: center; gap: 10px;">
                    <input asp-for="HasAC" type="checkbox" style="width: 20px; height: 20px; accent-color: #3498db;" />
                    <label asp-for="HasAC" style="color: #ffffff; font-family: 'Montserrat', sans-serif; cursor: pointer; margin: 0;">Are Aer Conditionat</label>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div style="text-align: left; margin-bottom: 15px;">
                    <label asp-for="Transmission" style="color: #bdc3c7; margin-bottom: 8px; display: block; font-family: 'Montserrat', sans-serif;">Transmisie</label>
                    <select asp-for="Transmission" required style="width: 100%; padding: 12px; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; outline: none; font-size: 1rem; font-family: 'Montserrat', sans-serif; background: rgba(255, 255, 255, 0.05); color: #ffffff; cursor: pointer; appearance: auto;">
                        <option value="" style="color: black;">-- Selecteaza Transmisia --</option>
                        <option value="Manuala" selected="@(Model.Transmission == "Manuala" ? "selected" : null)" style="color: black;">Manuala</option>
                        <option value="Automata" selected="@(Model.Transmission == "Automata" ? "selected" : null)" style="color: black;">Automata</option>
                    </select>
                    <span asp-validation-for="Transmission" class="text-danger" style="display: block; margin-top: 5px; font-size: 0.85rem;"></span>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div style="text-align: left; margin-bottom: 15px;">
                    <label asp-for="FuelType" style="color: #bdc3c7; margin-bottom: 8px; display: block; font-family: 'Montserrat', sans-serif;">Combustibil</label>
                    <select asp-for="FuelType" required style="width: 100%; padding: 12px; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; outline: none; font-size: 1rem; font-family: 'Montserrat', sans-serif; background: rgba(255, 255, 255, 0.05); color: #ffffff; cursor: pointer; appearance: auto;">
                        <option value="" style="color: black;">-- Selecteaza Combustibilul --</option>
                        <option value="Benzina" selected="@(Model.FuelType == "Benzina" ? "selected" : null)" style="color: black;">Benzina</option>
                        <option value="Benzina + GPL" selected="@(Model.FuelType == "Benzina + GPL" ? "selected" : null)" style="color: black;">Benzina + GPL</option>
                        <option value="Benzina + Hybrid" selected="@(Model.FuelType == "Benzina + Hybrid" ? "selected" : null)" style="color: black;">Benzina + Hybrid</option>
                        <option value="Diesel" selected="@(Model.FuelType == "Diesel" ? "selected" : null)" style="color: black;">Diesel</option>
                        <option value="Electric" selected="@(Model.FuelType == "Electric" ? "selected" : null)" style="color: black;">Electric</option>
                    </select>
                    <span asp-validation-for="FuelType" class="text-danger" style="display: block; margin-top: 5px; font-size: 0.85rem;"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-4">
                <div style="text-align: left; margin-bottom: 15px;">
                    <label asp-for="CategoryId" style="color: #bdc3c7; margin-bottom: 8px; display: block; font-family: 'Montserrat', sans-serif;">Categorie Caroserie</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" required style="width: 100%; padding: 12px; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; outline: none; font-size: 1rem; font-family: 'Montserrat', sans-serif; background: rgba(255, 255, 255, 0.05); color: #ffffff; cursor: pointer; appearance: auto;">
                        <option value="" style="color: black;">-- Selecteaza Categoria --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger" style="display: block; margin-top: 5px; font-size: 0.85rem;"></span>
                </div>
            </div>
            <div class="col-md-6 mb-4">
                <div style="text-align: left; margin-bottom: 15px;">
                    <label asp-for="ImageFiles" style="color: #bdc3c7; margin-bottom: 8px; display: block; font-family: 'Montserrat', sans-serif;">Adauga Imagini Noi (PNG/JPG)</label>
                    <input asp-for="ImageFiles" type="file" multiple accept="image/png, image/jpeg, image/jpg" style="width: 100%; padding: 12px; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; outline: none; font-size: 1rem; font-family: 'Montserrat', sans-serif; background: rgba(255, 255, 255, 0.05); color: #ffffff;" />
                    <span asp-validation-for="ImageFiles" class="text-danger" style="display: block; margin-top: 5px; font-size: 0.85rem;"></span>
                </div>
            </div>
        </div>

        @if (Model.Images != null && Model.Images.Any())
        {
            <div class="row mb-4">
                <div class="col-12">
                    <label style="color: #bdc3c7; margin-bottom: 15px; display: block; font-family: 'Montserrat', sans-serif;">Imagini Existente (Click pentru stergere)</label>
                    <div style="display: flex; gap: 15px; flex-wrap: wrap; background: rgba(0,0,0,0.2); padding: 15px; border-radius: 10px;">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl) && Model.ImageUrl != "default-car.png")
                        {
                            <div class="existing-image-container" style="position: relative; width: 100px; height: 75px;">
                                <img src="~/imagini/@Model.ImageUrl" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2);" />
                                <span style="position: absolute; bottom: 0; left: 0; width: 100%; background: rgba(0,0,0,0.7); color: white; font-size: 0.6rem; text-align: center; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">Principala</span>
                            </div>
                        }
                        
                        @foreach (var img in Model.Images)
                        {
                            <div class="existing-image-container" id="img-container-@img.Id" style="position: relative; width: 100px; height: 75px;">
                                <img src="~/imagini/@img.ImageUrl" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2);" />
                                <button type="button" onclick="deleteImage(@img.Id)" style="position: absolute; top: -5px; right: -5px; background: #e74c3c; color: white; border: none; border-radius: 50%; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 12px; line-height: 1;">&times;</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="d-flex justify-content-end gap-3 mt-2">
            <button type="button" class="btn-login-submit custom-modal-close-btn" style="background: rgba(255, 255, 255, 0.1); color: white; width: auto; margin: 0; padding: 10px 25px;">Anuleaza</button>
            <button type="submit" class="btn-login-submit" style="width: auto; margin: 0; padding: 10px 25px; box-shadow: 0 4px 15px rgba(52, 152, 219, 0.4);">Salveaza Modificarile</button>
        </div>
    </form>
</div>
