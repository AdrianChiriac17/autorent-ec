@model IEnumerable<AutoRentCraiova.Models.Car>

@{
    ViewData["Title"] = "Flota Noastra";
}

<style>
    .status-badge {
        position: absolute;
        top: 20px;
        left: -10px;
        padding: 8px 15px;
        border-radius: 8px;
        font-family: 'Outfit', sans-serif;
        font-size: 0.9rem;
        font-weight: bold;
        color: white;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.4);
        z-index: 10;
        text-transform: uppercase;
    }
    .status-0 { background: linear-gradient(135deg, #2ecc71, #27ae60); }
    .status-1 { background: linear-gradient(135deg, #f39c12, #d35400); }
    .status-2 { background: linear-gradient(135deg, #e74c3c, #c0392b); }

    .status-select {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white;
        border-radius: 50px;
        padding: 5px 10px;
        font-family: 'Montserrat', sans-serif;
        font-size: 0.8rem;
        outline: none;
        cursor: pointer;
    }
    .status-select option {
        background: #2c3e50;
        color: white;
    }
</style>

<section class="fleet-section">
    <div class="container">
        @if (User.IsInRole("FleetManager") || User.IsInRole("SystemAdministrator"))
        {
            <div class="fleet-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; flex-wrap: wrap; gap: 20px;">
                <h2 class="section-title" style="margin: 0;">Masini Disponibile</h2>
                <div class="header-actions" style="display: flex; gap: 15px; flex-wrap: wrap;">
                    <a asp-controller="Admin" asp-action="PriceLogs" class="btn-sexy-secondary" style="background-color: #16a085; border-color: #16a085; color: white;">Istoric Preturi</a>
                    <a asp-controller="Categories" asp-action="Index" class="btn-sexy-secondary">Gestioneaza Categorii</a>
                    <a asp-action="Create" class="btn-sexy-primary">Adauga Masina Noua</a>
                </div>
            </div>
        }

        <div class="search-container" style="margin-bottom: 30px; background: rgba(15, 23, 42, 0.4); padding: 20px; border-radius: 15px; border: 1px solid rgba(255, 255, 255, 0.15); backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px);">
            <form asp-action="Index" method="get" style="display: flex; flex-wrap: wrap; gap: 15px; align-items: flex-end;">
                
                <div style="flex: 1; min-width: 200px;">
                    <label style="display: block; margin-bottom: 5px; color: #bdc3c7; font-family: 'Montserrat', sans-serif; font-size: 0.85rem;">Cautare Text</label>
                    <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" placeholder="Brand sau model..." style="width: 100%; padding: 10px 15px; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; outline: none; font-family: 'Montserrat', sans-serif; background: rgba(255, 255, 255, 0.05); color: white;">
                </div>

                <div style="flex: 1; min-width: 150px;">
                    <label style="display: block; margin-bottom: 5px; color: #bdc3c7; font-family: 'Montserrat', sans-serif; font-size: 0.85rem;">Categorie</label>
                    <select name="categoryId" asp-items="ViewBag.Categories" style="width: 100%; padding: 10px 15px; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; outline: none; font-family: 'Montserrat', sans-serif; background: rgba(255, 255, 255, 0.05); color: white; appearance: auto; cursor: pointer;">
                        <option value="" style="color: black;">Toate</option>
                    </select>
                </div>

                <div style="flex: 1; min-width: 150px;">
                    <label style="display: block; margin-bottom: 5px; color: #bdc3c7; font-family: 'Montserrat', sans-serif; font-size: 0.85rem;">Transmisie</label>
                    <select name="transmission" asp-items="ViewBag.Transmissions" style="width: 100%; padding: 10px 15px; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; outline: none; font-family: 'Montserrat', sans-serif; background: rgba(255, 255, 255, 0.05); color: white; appearance: auto; cursor: pointer;">
                        <option value="" style="color: black;">Toate</option>
                    </select>
                </div>

                <div style="flex: 1; min-width: 150px;">
                    <label style="display: block; margin-bottom: 5px; color: #bdc3c7; font-family: 'Montserrat', sans-serif; font-size: 0.85rem;">Combustibil</label>
                    <select name="fuelType" asp-items="ViewBag.FuelTypes" style="width: 100%; padding: 10px 15px; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; outline: none; font-family: 'Montserrat', sans-serif; background: rgba(255, 255, 255, 0.05); color: white; appearance: auto; cursor: pointer;">
                        <option value="" style="color: black;">Toate</option>
                    </select>
                </div>
                
                <div style="flex: 1; min-width: 150px;">
                    <label style="display: block; margin-bottom: 5px; color: #bdc3c7; font-family: 'Montserrat', sans-serif; font-size: 0.85rem;">Status</label>
                    <select name="status" asp-items="ViewBag.Statuses" style="width: 100%; padding: 10px 15px; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; outline: none; font-family: 'Montserrat', sans-serif; background: rgba(255, 255, 255, 0.05); color: white; appearance: auto; cursor: pointer;">
                        <option value="" style="color: black;">Toate</option>
                    </select>
                </div>

                <div style="flex: 1; min-width: 150px;">
                    <label style="display: block; margin-bottom: 5px; color: #bdc3c7; font-family: 'Montserrat', sans-serif; font-size: 0.85rem;">Sortare</label>
                    <select name="sortOrder" style="width: 100%; padding: 10px 15px; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; outline: none; font-family: 'Montserrat', sans-serif; background: rgba(255, 255, 255, 0.05); color: white; appearance: auto; cursor: pointer;">
                        <option value="" selected="@(ViewData["CurrentSort"] == null ? "selected" : null)" style="color: black;">Cele mai noi</option>
                        <option value="price_asc" selected="@(ViewData["CurrentSort"]?.ToString() == "price_asc" ? "selected" : null)" style="color: black;">Pret: Mic la Mare</option>
                        <option value="price_desc" selected="@(ViewData["CurrentSort"]?.ToString() == "price_desc" ? "selected" : null)" style="color: black;">Pret: Mare la Mic</option>
                    </select>
                </div>

                <div style="display: flex; gap: 10px;">
                    <button type="submit" class="btn-sexy-primary" style="padding: 10px 20px; height: 46px;">Aplica</button>
                    @if (ViewData["CurrentSearch"] != null || ViewData["CurrentCategory"] != null || ViewData["CurrentTransmission"] != null || ViewData["CurrentFuel"] != null || ViewData["CurrentStatus"] != null || ViewData["CurrentSort"] != null)
                    {
                        <a asp-action="Index" asp-route-clearSearch="true" class="btn-sexy-secondary" style="padding: 10px 15px; height: 46px; background: rgba(231, 76, 60, 0.2); border-color: rgba(231, 76, 60, 0.5); display: flex; align-items: center; justify-content: center;" title="Sterge toate filtrele">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                        </a>
                    }
                </div>
            </form>
        </div>

        @if (User.IsInRole("FleetManager") || User.IsInRole("SystemAdministrator"))
        {
            <div class="dashboard-stats" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 30px;">
                <div class="stat-card" style="background: rgba(15, 23, 42, 0.4); padding: 20px; border-radius: 15px; border: 1px solid rgba(255, 255, 255, 0.1); backdrop-filter: blur(10px); text-align: center;">
                    <h3 style="color: #bdc3c7; font-size: 1rem; font-family: 'Montserrat', sans-serif; margin-bottom: 10px; text-transform: uppercase;">Total Masini</h3>
                    <span style="color: white; font-size: 2.5rem; font-family: 'Outfit', sans-serif; font-weight: bold;">@ViewBag.TotalCars</span>
                </div>
                <div class="stat-card" style="background: rgba(46, 204, 113, 0.1); padding: 20px; border-radius: 15px; border: 1px solid rgba(46, 204, 113, 0.3); backdrop-filter: blur(10px); text-align: center;">
                    <h3 style="color: #2ecc71; font-size: 1rem; font-family: 'Montserrat', sans-serif; margin-bottom: 10px; text-transform: uppercase;">Disponibile</h3>
                    <span style="color: white; font-size: 2.5rem; font-family: 'Outfit', sans-serif; font-weight: bold;">@ViewBag.AvailableCars</span>
                </div>
                <div class="stat-card" style="background: rgba(231, 76, 60, 0.1); padding: 20px; border-radius: 15px; border: 1px solid rgba(231, 76, 60, 0.3); backdrop-filter: blur(10px); text-align: center;">
                    <h3 style="color: #e74c3c; font-size: 1rem; font-family: 'Montserrat', sans-serif; margin-bottom: 10px; text-transform: uppercase;">Inchiriate</h3>
                    <span style="color: white; font-size: 2.5rem; font-family: 'Outfit', sans-serif; font-weight: bold;">@ViewBag.RentedCars</span>
                </div>
                <div class="stat-card" style="background: rgba(243, 156, 18, 0.1); padding: 20px; border-radius: 15px; border: 1px solid rgba(243, 156, 18, 0.3); backdrop-filter: blur(10px); text-align: center;">
                    <h3 style="color: #f39c12; font-size: 1rem; font-family: 'Montserrat', sans-serif; margin-bottom: 10px; text-transform: uppercase;">In Mentenanta</h3>
                    <span style="color: white; font-size: 2.5rem; font-family: 'Outfit', sans-serif; font-weight: bold;">@ViewBag.MaintenanceCars</span>
                </div>
            </div>
        }

        <div class="car-grid" id="car-grid">
            <partial name="_CarsListPartial" model="Model" />
        </div>
        
        <div id="loading-indicator" style="display: none; text-align: center; padding: 20px;">
            <p>Incarcare...</p>
        </div>

        @if (!Model.Any())
        {
            <div style="grid-column: 1 / -1; text-align: center; padding: 50px; background: rgba(15, 23, 42, 0.4); border-radius: 20px; border: 1px solid rgba(255,255,255,0.1);">
                <p style="color: #bdc3c7; font-family: 'Montserrat', sans-serif; font-size: 1.2rem; margin: 0;">Nu am gasit nicio masina care sa corespunda filtrelor selectate.</p>
            </div>
        }
    </div>
</section>

<!-- container modal -->
<div id="carDetailsModal" class="custom-modal">
    <div class="custom-modal-content">
        <span class="custom-modal-close">&times;</span>
        <div id="modal-body-content">
            <div class="loading-spinner">Incarcare...</div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function changeCarStatus(id, newStatus) {
            fetch(`/Cars/ChangeStatus?id=${id}&newStatus=${newStatus}`, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if(data.success) {
                    location.reload(); 
                } else {
                    alert("Eroare la schimbarea statusului");
                }
            });
        }
        
        function deleteImage(id) {
            if(confirm('Esti sigur ca vrei sa stergi aceasta imagine?')) {
                fetch(`/Cars/DeleteImage?imageId=${id}`, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(r => r.json())
                .then(data => {
                    if(data.success) {
                        const imgContainer = document.getElementById('img-container-' + id);
                        if (imgContainer) {
                            imgContainer.remove();
                        }
                    } else {
                        alert('Eroare la stergerea imaginii: ' + (data.message || 'Eroare necunoscuta'));
                    }
                })
                .catch(error => {
                    console.error('Eroare:', error);
                    alert('A aparut o eroare de retea la stergerea imaginii.');
                });
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            // event delegation in site.js

            // infinite scrolling
            let page = 1;
            let isLoading = false;
            const loadingIndicator = document.getElementById('loading-indicator');
            const carGrid = document.getElementById('car-grid');

            function loadMoreCars() {
                if (isLoading) return;
                isLoading = true;
                loadingIndicator.style.display = 'block';

                const searchParams = new URLSearchParams(window.location.search);
                searchParams.set('page', page);

                fetch(`/Cars/LoadMoreCars?${searchParams.toString()}`)
                    .then(response => response.text())
                    .then(html => {
                        if (html.trim().length > 0) {
                            const tempDiv = document.createElement('div');
                            tempDiv.innerHTML = html;
                            const newCards = Array.from(tempDiv.children);
                            newCards.forEach(card => {
                                carGrid.appendChild(card);
                            });
                            page++;
                            isLoading = false;
                        }
                        loadingIndicator.style.display = 'none';
                    })
                    .catch(error => {
                        console.error('Error loading more cars:', error);
                        isLoading = false;
                        loadingIndicator.style.display = 'none';
                    });
            }

            window.addEventListener('scroll', () => {
                if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 100) {
                    loadMoreCars();
                }
            });
        });
    </script>
}
