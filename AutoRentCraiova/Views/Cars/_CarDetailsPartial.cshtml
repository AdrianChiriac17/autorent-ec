@model AutoRentCraiova.Models.Car

<div class="modal-car-details">
    <div class="modal-image-container" style="position: relative;">
        <img id="main-detail-image" src="~/imagini/@(!string.IsNullOrEmpty(Model.ImageUrl) ? Model.ImageUrl : "default-car.png")" alt="@Model.Brand @Model.Model" class="modal-img">
    </div>
    
    @if (Model.Images != null && Model.Images.Any())
    {
        <div style="display: flex; gap: 10px; margin-top: 15px; overflow-x: auto; padding-bottom: 10px;">
            <img src="~/imagini/@(!string.IsNullOrEmpty(Model.ImageUrl) ? Model.ImageUrl : "default-car.png")" 
                 onclick="document.getElementById('main-detail-image').src = this.src"
                 style="width: 80px; height: 60px; object-fit: cover; border-radius: 8px; cursor: pointer; border: 2px solid transparent; transition: 0.3s;"
                 onmouseover="this.style.borderColor='#3498db'" onmouseout="this.style.borderColor='transparent'" />
                 
            @foreach (var img in Model.Images)
            {
                <img src="~/imagini/@img.ImageUrl" 
                     onclick="document.getElementById('main-detail-image').src = this.src"
                     style="width: 80px; height: 60px; object-fit: cover; border-radius: 8px; cursor: pointer; border: 2px solid transparent; transition: 0.3s;"
                     onmouseover="this.style.borderColor='#3498db'" onmouseout="this.style.borderColor='transparent'" />
            }
        </div>
    }

    <div class="modal-info-container" style="margin-top: 20px;">
        <h2 class="modal-title">@Model.Brand @Model.Model</h2>
        <span class="modal-year" style="font-family: 'Montserrat', sans-serif; color: #bdc3c7; margin-bottom: 15px; display: block;">An fabricatie: @Model.Year</span>
        
        <div style="background: rgba(0,0,0,0.2); padding: 10px 15px; border-radius: 10px; margin-bottom: 25px; font-size: 0.9rem; text-align: center;">
            <strong style="color: #e67e22; font-family: 'Outfit', sans-serif; letter-spacing: 1px;">@Model.LicensePlate</strong>
            <span style="color: rgba(255,255,255,0.3); margin: 0 10px;">|</span>
            <span style="color: #bdc3c7; font-family: 'Montserrat', sans-serif;">VIN: @Model.VIN</span>
        </div>

        <div class="modal-specs-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px;">
            <div class="spec-item" style="display: flex; align-items: center; background: rgba(255, 255, 255, 0.05); padding: 15px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.05);">
                <span class="spec-icon" style="margin-right: 15px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #2ecc71;"><path d="M3 22V8a5 5 0 0 1 10 0v14"></path><path d="M13 14h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-6"></path><path d="M19 14v4a2 2 0 0 0 2 2h0a2 2 0 0 0 2-2v-5"></path><path d="M8 22v-8"></path><path d="M8 10V6"></path></svg>
                </span>
                <div class="spec-text" style="display: flex; flex-direction: column;">
                    <small style="font-family: 'Montserrat', sans-serif; color: #7f8c8d; font-size: 0.8rem; text-transform: uppercase;">Combustibil</small>
                    <strong style="font-family: 'Outfit', sans-serif; color: white; font-size: 1.1rem;">@Model.FuelType</strong>
                </div>
            </div>
            
            <div class="spec-item" style="display: flex; align-items: center; background: rgba(255, 255, 255, 0.05); padding: 15px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.05);">
                <span class="spec-icon" style="margin-right: 15px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #3498db;"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="3"></circle><line x1="12" y1="9" x2="12" y2="3"></line><line x1="9" y1="12" x2="3" y2="12"></line><line x1="15" y1="12" x2="21" y2="12"></line><line x1="12" y1="15" x2="12" y2="21"></line><line x1="10" y1="10" x2="6.5" y2="6.5"></line><line x1="14" y1="10" x2="17.5" y2="6.5"></line><line x1="10" y1="14" x2="6.5" y2="17.5"></line><line x1="14" y1="14" x2="17.5" y2="17.5"></line></svg>
                </span>
                <div class="spec-text" style="display: flex; flex-direction: column;">
                    <small style="font-family: 'Montserrat', sans-serif; color: #7f8c8d; font-size: 0.8rem; text-transform: uppercase;">Transmisie</small>
                    <strong style="font-family: 'Outfit', sans-serif; color: white; font-size: 1.1rem;">@Model.Transmission</strong>
                </div>
            </div>
            
            <div class="spec-item" style="display: flex; align-items: center; background: rgba(255, 255, 255, 0.05); padding: 15px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.05);">
                <span class="spec-icon" style="margin-right: 15px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #e67e22;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                </span>
                <div class="spec-text" style="display: flex; flex-direction: column;">
                    <small style="font-family: 'Montserrat', sans-serif; color: #7f8c8d; font-size: 0.8rem; text-transform: uppercase;">Locuri</small>
                    <strong style="font-family: 'Outfit', sans-serif; color: white; font-size: 1.1rem;">@Model.Seats</strong>
                </div>
            </div>

            <div class="spec-item" style="display: flex; align-items: center; background: rgba(255, 255, 255, 0.05); padding: 15px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.05);">
                <span class="spec-icon" style="margin-right: 15px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #9b59b6;"><path d="M18 3H6a2 2 0 0 0-2 2v16h16V5a2 2 0 0 0-2-2z"></path><path d="M14 12v.01"></path></svg>
                </span>
                <div class="spec-text" style="display: flex; flex-direction: column;">
                    <small style="font-family: 'Montserrat', sans-serif; color: #7f8c8d; font-size: 0.8rem; text-transform: uppercase;">Usi</small>
                    <strong style="font-family: 'Outfit', sans-serif; color: white; font-size: 1.1rem;">@Model.Doors</strong>
                </div>
            </div>

            <div class="spec-item" style="display: flex; align-items: center; background: rgba(255, 255, 255, 0.05); padding: 15px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.05);">
                <span class="spec-icon" style="margin-right: 15px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #9b59b6;"><path d="M12 2v20"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                </span>
                <div class="spec-text" style="display: flex; flex-direction: column;">
                    <small style="font-family: 'Montserrat', sans-serif; color: #7f8c8d; font-size: 0.8rem; text-transform: uppercase;">Consum</small>
                    <strong style="font-family: 'Outfit', sans-serif; color: white; font-size: 1.1rem;">@Model.AverageConsumption L/100km</strong>
                </div>
            </div>
            
            <div class="spec-item" style="display: flex; align-items: center; background: rgba(255, 255, 255, 0.05); padding: 15px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.05);">
                <span class="spec-icon" style="margin-right: 15px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #1abc9c;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                </span>
                <div class="spec-text" style="display: flex; flex-direction: column;">
                    <small style="font-family: 'Montserrat', sans-serif; color: #7f8c8d; font-size: 0.8rem; text-transform: uppercase;">Aer Conditionat</small>
                    <strong style="font-family: 'Outfit', sans-serif; color: white; font-size: 1.1rem;">@(Model.HasAC ? "Da" : "Nu")</strong>
                </div>
            </div>

            <div class="spec-item" style="display: flex; align-items: center; background: rgba(255, 255, 255, 0.05); padding: 15px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.05);">
                <span class="spec-icon" style="margin-right: 15px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #f1c40f;"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                </span>
                <div class="spec-text" style="display: flex; flex-direction: column;">
                    <small style="font-family: 'Montserrat', sans-serif; color: #7f8c8d; font-size: 0.8rem; text-transform: uppercase;">Categorie</small>
                    <strong style="font-family: 'Outfit', sans-serif; color: white; font-size: 1.1rem;">@(Model.Category?.Name ?? "N/A")</strong>
                </div>
            </div>
        </div>

        <div class="modal-price-section" style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <span class="price-label">Pret inchiriere:</span>
                <div class="price-value">
                    <strong>@Model.PricePerDay</strong>
                    <span>RON / zi</span>
                </div>
            </div>
            @if (Model.Status == CarStatus.Disponibila)
            {
                <a href="/Reservations/Book/@Model.Id" class="btn-sexy-primary" style="text-decoration: none; display: inline-flex; align-items: center; justify-content: center; height: 50px; padding: 0 30px;">
                    Rezerva Acum
                </a>
            }
            else
            {
                <button class="btn-sexy-secondary" disabled style="opacity: 0.5; cursor: not-allowed; height: 50px; padding: 0 30px;">
                    Indisponibila
                </button>
            }
        </div>
    </div>
</div>