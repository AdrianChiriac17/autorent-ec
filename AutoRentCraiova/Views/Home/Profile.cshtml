@model ProfileViewModel

@{
    ViewData["Title"] = "Profil - AutoRent Craiova";
}

<div class="login-page-wrapper">
    <div class="login-container" style="max-width: 800px; padding: 40px;"> 
        <form asp-action="Profile" method="post" enctype="multipart/form-data" class="login-form">
            <h2 class="text-center mb-4">Profilul Meu</h2> 
            
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info">@TempData["InfoMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            
            <div class="row">
                <div class="col-md-6">
                    <h4 class="text-white mb-3" style="font-family: 'Outfit', sans-serif;">Date Personale</h4>
                    <div class="form-group mb-3"> 
                        <label asp-for="FullName" class="form-label form-label-dark">Nume complet</label> 
                        <input asp-for="FullName" class="form-control" placeholder="Nume complet" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Email" class="form-label form-label-dark">Email</label>
                        <input asp-for="Email" class="form-control" placeholder="Email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-4"> 
                        <label asp-for="CNP" class="form-label form-label-dark">CNP</label>
                        <input asp-for="CNP" class="form-control" placeholder="CNP" />
                        <span asp-validation-for="CNP" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <h4 class="text-white mb-3" style="font-family: 'Outfit', sans-serif;">Verificare Documente</h4>
                    
                    <div class="mb-3 p-3 rounded" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                        <p class="text-white mb-2">Status Documente: 
                            <span class="badge @(Model.DocumentsStatus == AutoRentCraiova.Models.DocumentStatus.Approved ? "badge-success" : (Model.DocumentsStatus == AutoRentCraiova.Models.DocumentStatus.Pending ? "badge-warning" : (Model.DocumentsStatus == AutoRentCraiova.Models.DocumentStatus.Rejected ? "badge-danger" : "badge-secondary")))">
                                @Model.DocumentsStatus
                            </span>
                        </p>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label form-label-dark">Incarca poza Permis Auto</label>
                        <input type="file" asp-for="DriverLicenseImage" class="form-control bg-dark text-white" accept=".png,.jpg,.jpeg,.pdf" />
                        @if(!string.IsNullOrEmpty(Model.DriverLicenseUrl))
                        {
                            <small class="text-success d-block mt-1">Ai un permis incarcat. Incarca un fisier nou doar daca vrei sa il inlocuiesti.</small>
                        }
                    </div>

                    <div class="form-group mb-4">
                        <label class="form-label form-label-dark">Incarca poza Buletin (CI)</label>
                        <input type="file" asp-for="IdCardImage" class="form-control bg-dark text-white" accept=".png,.jpg,.jpeg,.pdf" />
                        @if(!string.IsNullOrEmpty(Model.IdCardUrl))
                        {
                            <small class="text-success d-block mt-1">Ai un buletin incarcat. Incarca un fisier nou doar daca vrei sa il inlocuiesti.</small>
                        }
                    </div>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-md-6 mb-2">
                    <button type="submit" class="btn-sexy-primary w-100">Salveaza Modificarile</button> 
                </div>
                <div class="col-md-6 mb-2">
                    <a asp-controller="Home" asp-action="Index" class="btn-sexy-secondary w-100 text-center">Inapoi Acasa</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
