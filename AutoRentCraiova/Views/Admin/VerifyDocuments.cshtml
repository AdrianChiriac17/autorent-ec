@model AutoRentCraiova.Models.User

@{
    ViewData["Title"] = "Verificare Acte - " + Model.FullName;
}

<section class="fleet-section" style="padding-top: 120px; min-height: 80vh;">
    <div class="container">
        <h2 class="section-title mb-4">Verificare Acte: @Model.FullName</h2>

        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="card bg-dark text-white" style="border: 1px solid rgba(255,255,255,0.1);">
                    <div class="card-header border-bottom-0" style="background: rgba(255,255,255,0.05);">
                        <h4 class="mb-0" style="font-family: 'Outfit', sans-serif;">Permis Auto</h4>
                    </div>
                    <div class="card-body text-center">
                        @if (!string.IsNullOrEmpty(Model.DriverLicenseUrl))
                        {
                            @if (Model.DriverLicenseUrl.EndsWith(".pdf", System.StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="mb-3">
                                    <span style="font-size: 48px; font-weight: bold; color: #e74c3c;">[PDF]</span>
                                    <p class="mt-2">Fisier PDF</p>
                                </div>
                            }
                            else
                            {
                                <img src="/imagini/documente/@Model.DriverLicenseUrl" alt="Permis Auto" class="img-fluid rounded" style="max-height: 300px; object-fit: contain;" />
                            }
                            <div class="mt-3">
                                <a href="/imagini/documente/@Model.DriverLicenseUrl" target="_blank" class="btn btn-sm btn-info">Vezi documentul</a>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">Utilizatorul nu a incarcat permisul.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card bg-dark text-white" style="border: 1px solid rgba(255,255,255,0.1);">
                    <div class="card-header border-bottom-0" style="background: rgba(255,255,255,0.05);">
                        <h4 class="mb-0" style="font-family: 'Outfit', sans-serif;">Buletin (CI)</h4>
                    </div>
                    <div class="card-body text-center">
                        @if (!string.IsNullOrEmpty(Model.IdCardUrl))
                        {
                            @if (Model.IdCardUrl.EndsWith(".pdf", System.StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="mb-3">
                                    <span style="font-size: 48px; font-weight: bold; color: #e74c3c;">[PDF]</span>
                                    <p class="mt-2">Fisier PDF</p>
                                </div>
                            }
                            else
                            {
                                <img src="/imagini/documente/@Model.IdCardUrl" alt="Buletin" class="img-fluid rounded" style="max-height: 300px; object-fit: contain;" />
                            }
                            <div class="mt-3">
                                <a href="/imagini/documente/@Model.IdCardUrl" target="_blank" class="btn btn-sm btn-info">Vezi documentul</a>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">Utilizatorul nu a incarcat buletinul.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="contact-form-card p-4 mt-2 text-center" style="max-width: 600px; margin: 0 auto;">
            <h4 class="text-white mb-3">Decizie Status Documente</h4>
            <p class="text-white">Status actual: 
                <span class="badge @(Model.DocumentsStatus == AutoRentCraiova.Models.DocumentStatus.Approved ? "badge-success" : (Model.DocumentsStatus == AutoRentCraiova.Models.DocumentStatus.Pending ? "badge-warning" : (Model.DocumentsStatus == AutoRentCraiova.Models.DocumentStatus.Rejected ? "badge-danger" : "badge-secondary")))" id="doc-status-badge">
                    @Model.DocumentsStatus
                </span>
            </p>

            <div class="d-flex justify-content-center gap-3 mt-4">
                <button class="btn btn-success px-4 py-2" onclick="updateDocStatus(@Model.Id, 2)" style="font-family: 'Outfit', sans-serif;">Aproba Acte</button>
                <button class="btn btn-danger px-4 py-2" onclick="updateDocStatus(@Model.Id, 3)" style="font-family: 'Outfit', sans-serif;">Respinge Acte</button>
            </div>
            
            <div class="mt-4">
                <a asp-controller="Admin" asp-action="Reservations" class="text-muted" style="text-decoration: underline;">Inapoi la rezervari</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function updateDocStatus(userId, status) {
            fetch('/Admin/UpdateDocumentStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: `userId=${userId}&status=${status}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const badge = document.getElementById('doc-status-badge');
                    if(status == 2) {
                        badge.innerText = "Approved";
                        badge.className = 'badge badge-success';
                        alert("Actele au fost Aprobate cu succes!");
                    } else if (status == 3) {
                        badge.innerText = "Rejected";
                        badge.className = 'badge badge-danger';
                        alert("Actele au fost Respinse!");
                    }
                }
            })
            .catch(error => console.error('Error:', error));
        }
    </script>
}
