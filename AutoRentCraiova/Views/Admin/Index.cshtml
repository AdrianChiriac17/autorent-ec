@model IEnumerable<AutoRentCraiova.Models.Contact>

@{
    ViewData["Title"] = "Admin Panel - Mesaje Contact";
}

<style>
    .message-read {
        opacity: 0.6;
    }
    .message-read td {
        color: #7f8c8d !important;
    }
    .message-read strong {
        color: #95a5a6 !important;
    }
    
    .btn-toggle-read {
        background: linear-gradient(135deg, #f39c12, #d35400);
        box-shadow: 0 4px 15px rgba(243, 156, 18, 0.4);
    }
    .btn-toggle-read[data-is-read="true"] {
        background: linear-gradient(135deg, #3498db, #2980b9);
        box-shadow: 0 4px 15px rgba(52, 152, 219, 0.4);
    }
    .btn-toggle-read:hover {
        transform: translateY(-4px) scale(1.05);
    }
    .btn-toggle-read[data-is-read="false"]:hover {
        box-shadow: 0 0 20px rgba(243, 156, 18, 0.8), 0 8px 25px rgba(243, 156, 18, 0.5);
    }
    .btn-toggle-read[data-is-read="true"]:hover {
        box-shadow: 0 0 20px rgba(52, 152, 219, 0.8), 0 8px 25px rgba(52, 152, 219, 0.5);
    }
    
    .message-row {
        transition: opacity 0.3s ease, background-color 0.3s ease;
    }
</style>

<section class="fleet-section">
    <div class="container">
        <div class="fleet-header">
            <h2 class="section-title">Mesaje Primite</h2>
            <div class="header-actions" style="display: flex; gap: 15px;">
                <a asp-controller="Home" asp-action="Contact" class="btn btn-secondary" style="background-color: #34495e; border-color: #34495e; font-family: 'Outfit', sans-serif;">Inapoi la Contact</a>
            </div>
        </div>

        <div class="contact-form-card" style="margin-top: 30px; max-width: 100%;">
            <div class="table-responsive">
                <table class="table table-dark table-striped" style="background: transparent; margin-bottom: 0;">
                    <thead>
                        <tr style="border-bottom: 2px solid #3498db;">
                            <th style="font-family: 'Outfit', sans-serif; font-size: 1.1rem; padding: 15px;">Expeditor</th>
                            <th style="font-family: 'Outfit', sans-serif; font-size: 1.1rem; padding: 15px;">Subiect & Mesaj</th>
                            <th style="font-family: 'Outfit', sans-serif; font-size: 1.1rem; padding: 15px; text-align: right; min-width: 150px;">Actiuni</th>
                        </tr>
                    </thead>
                    <tbody id="messages-table-body">
                    @foreach (var item in Model) {
                        <tr class="message-row @(item.IsRead ? "message-read" : "")" id="message-row-@item.Id">
                            <td style="font-family: 'Montserrat', sans-serif; padding: 20px 15px; vertical-align: top; width: 25%;">
                                <strong>@item.Name</strong><br />
                                <a href="mailto:@item.Email" style="color: #3498db; text-decoration: none; font-size: 0.9em;">@item.Email</a>
                            </td>
                            <td style="font-family: 'Montserrat', sans-serif; padding: 20px 15px; vertical-align: top;">
                                <strong style="color: #ecf0f1; display: block; margin-bottom: 5px;">@item.Subject</strong>
                                <p style="margin: 0; font-size: 0.95em; white-space: pre-wrap;">@item.Message</p>
                            </td>
                            <td style="padding: 15px; text-align: right; vertical-align: top;">
                                <div class="actions" style="justify-content: flex-end;">
                                    <button type="button" class="action-btn btn-toggle-read" data-is-read="@item.IsRead.ToString().ToLower()" title="@(item.IsRead ? "Marcheaza ca necitit" : "Marcheaza ca citit")" onclick="toggleReadStatus(@item.Id, this)">
                                        @if(item.IsRead) {
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                                        } else {
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                                        }
                                    </button>
                                    <button type="button" data-url="/Admin/Delete/@item.Id" class="action-btn btn-delete btn-open-modal" title="Sterge">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" style="text-align: center; padding: 30px; font-family: 'Montserrat', sans-serif; color: #bdc3c7;">
                                Nu exista mesaje in baza de date.
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<!-- container modal -->
<div class="custom-modal" style="display: none;">
    <div class="custom-modal-content">
        <span class="custom-modal-close">&times;</span>
        <div id="modal-body-content"></div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleReadStatus(id, btnElement) {
            // cerere POST catre server
            fetch(`/Admin/ToggleReadStatus/${id}`, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const row = document.getElementById(`message-row-${id}`);
                    const isRead = data.isRead;
                    const tbody = document.getElementById('messages-table-body');
                    
                    // update stare buton
                    btnElement.setAttribute('data-is-read', isRead.toString());
                    btnElement.title = isRead ? "Marcheaza ca necitit" : "Marcheaza ca citit";
                    
                    // animatie
                    row.style.opacity = '0';
                    
                    setTimeout(() => {
                        if (isRead) {
                            row.classList.add('message-read');
                            btnElement.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>';
                            // mutare la sf tabelului
                            tbody.appendChild(row);
                        } else {
                            row.classList.remove('message-read');
                            btnElement.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>';
                            // mutare la inc tabelului
                            tbody.insertBefore(row, tbody.firstChild);
                        }
                        
                        // refacere opacitate
                        requestAnimationFrame(() => {
                            row.style.opacity = '';
                        });
                    }, 300);
                    
                } else {
                    alert('Eroare la modificarea statusului.');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Eroare de retea.');
            });
        }
    </script>
}