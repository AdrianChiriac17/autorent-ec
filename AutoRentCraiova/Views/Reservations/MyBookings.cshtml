@model IEnumerable<AutoRentCraiova.Models.Reservation>

@{
    ViewData["Title"] = "Rezervarile Mele";
}

<section class="fleet-section" style="padding-top: 120px; min-height: 80vh;">
    <div class="container">
        <h2 class="section-title mb-4">Rezervarile Mele</h2>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (!Model.Any())
        {
            <div class="text-center p-5 contact-form-card">
                <h4 class="text-white">Nu ai nicio rezervare activa.</h4>
                <a asp-controller="Cars" asp-action="Index" class="btn-sexy-primary mt-3">Cauta o Masina</a>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var res in Model)
                {
                    <div class="col-md-6 mb-4">
                        <div class="contact-form-card h-100 position-relative">
                            <span class="badge badge-primary position-absolute" style="top: 15px; right: 15px; background: #3498db; padding: 8px 12px; font-family: 'Outfit', sans-serif;">@res.Status</span>
                            
                            <h4 class="text-white mb-1" style="font-family: 'Outfit', sans-serif;">@res.Car.Brand @res.Car.Model</h4>
                            <p class="text-muted mb-3" style="font-size: 0.9rem;">Referinta: <strong>#@res.BookingReference</strong></p>
                            
                            <hr style="border-color: rgba(255,255,255,0.1);" />
                            
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-white-50">Perioada:</span>
                                <strong class="text-white">@res.StartDate.ToString("dd MMM yyyy") - @res.EndDate.ToString("dd MMM yyyy")</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-white-50">Zile:</span>
                                <strong class="text-white">@((res.EndDate - res.StartDate).Days)</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-white-50">Asigurare:</span>
                                <strong class="text-white">@res.Insurance</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-3">
                                <span class="text-white-50">Extra:</span>
                                <strong class="text-white text-right">
                                    @(res.HasGps ? "GPS " : "")
                                    @(res.HasChildSeat ? "Scaun " : "")
                                    @(res.HasRoofRack ? "Portbagaj" : "")
                                    @(!res.HasGps && !res.HasChildSeat && !res.HasRoofRack ? "-" : "")
                                </strong>
                            </div>
                            
                            <div class="p-3 rounded text-center mt-auto" style="background: rgba(46, 204, 113, 0.1); border: 1px solid rgba(46, 204, 113, 0.3);">
                                <h5 class="mb-0" style="color: #2ecc71;">Total: @res.TotalPrice RON</h5>
                                @if (res.Status == AutoRentCraiova.Models.ReservationStatus.Confirmed || res.Status == AutoRentCraiova.Models.ReservationStatus.Completed)
                                {
                                    <div class="mt-3">
                                        <a asp-controller="Reservations" asp-action="Contract" asp-route-id="@res.Id" target="_blank" class="btn btn-sm btn-info w-100" style="font-family: 'Outfit', sans-serif;">
                                            Descarca Contract
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
