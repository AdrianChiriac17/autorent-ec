@model AutoRentCraiova.Models.Category

@{
    ViewData["Title"] = "Adauga Categorie";
}

<section class="fleet-section">
    <div class="container">
        <div class="fleet-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; flex-wrap: wrap; gap: 20px;">
            <h2 class="section-title" style="margin: 0;">Adauga o Categorie Noua</h2>
            <a asp-action="Index" class="btn-sexy-secondary">Inapoi la Categorii</a>
        </div>

        <div class="contact-form-card" style="margin-top: 30px; max-width: 600px;">
            <form asp-action="Create" method="post" class="login-form" style="background: transparent; padding: 0; box-shadow: none; max-width: 100%;">
                @Html.AntiForgeryToken()
                
                <div class="row">
                    <div class="col-md-12 mb-3">
                        <div style="text-align: left; margin-bottom: 15px;">
                            <label asp-for="Name" style="color: #bdc3c7; margin-bottom: 8px; display: block; font-family: 'Montserrat', sans-serif;">Nume Categorie</label>
                            <input asp-for="Name" required style="width: 100%; padding: 12px; border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 8px; outline: none; font-size: 1rem; font-family: 'Montserrat', sans-serif; background: rgba(255, 255, 255, 0.05); color: #ffffff;" />
                            <span asp-validation-for="Name" class="text-danger" style="display: block; margin-top: 5px; font-size: 0.85rem;"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-2">
                    <button type="submit" class="btn-sexy-primary">Adauga Categoria</button>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}